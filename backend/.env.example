# Backend environment configuration
# Copy this file to .env and replace values with your own secrets.
# Never commit the .env file.

# Application
APP_NAME="Smart EV Charging Station Management"
APP_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://root:changeme@localhost:27017/smart_ev_charging?authSource=admin
MONGODB_DB=smart_ev_charging

# Security
SECRET_KEY=replace-with-a-long-random-secret-key-for-development
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Password hashing (argon2 via passlib)
PASSWORD_SCHEME=argon2

# Seed / demo credentials (development only, change before production)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=AdminPass123!
SEED_ADMIN_FULL_NAME="System Administrator"
